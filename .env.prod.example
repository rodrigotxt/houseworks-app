# Molde do ambiente de PRODUÇÃO.
#
#   cp .env.prod.example .env.prod
#   # preencha, gere um JWT_SECRET novo, e:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# O .env.prod NUNCA vai para o repositório (o .gitignore já cobre .env.*).

# ---- Domínio ----
# O app inteiro vive aqui: a interface em https://SEU-DOMINIO e a API em
# https://SEU-DOMINIO/api/v1. Front e API no MESMO domínio é o que faz o cookie de sessão
# funcionar (SameSite=Lax). Não separe em dois domínios diferentes.
DOMAIN=houseworks.seudominio.com

# Para o Let's Encrypt avisar antes do certificado expirar.
ACME_EMAIL=voce@seudominio.com

# ---- MongoDB ----
MONGO_USER=houseworks
# Gere: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
MONGO_PASSWORD=troque-esta-senha
MONGO_DB_NAME=db_houseworks

# ---- Segredos ----
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reaproveite o de desenvolvimento.
JWT_SECRET_KEY=coloque-aqui-o-segredo-gerado

# Validade do TOKEN, em segundos. Curto de propósito: existe POST /auth/refresh.
JWT_EXPIRES_IN=3600

# Validade da SESSAO, em segundos (padrão: 30 dias). É o prazo do cookie E a janela em
# que um token já expirado ainda pode ser renovado — o token continua curto, a sessão é
# que dura. Encurtar isto significa pedir a senha de novo com mais frequência; numa TV,
# digitando com o controle remoto, é o que inviabiliza o painel.
SESSION_MAX_AGE=2592000

# ---- Web Push (lembretes) ----
# Gere UMA vez e guarde: trocar as chaves invalida as inscricoes dos aparelhos.
#   cd backend && npx web-push generate-vapid-keys
# Sem estas chaves o canal push fica desligado; os lembretes continuam no in_app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com
